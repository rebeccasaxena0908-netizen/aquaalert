# Classifier backend: "auto" (MuRIL if present, then embed_lr, then keyword fallback),
# or force one: "muril", "embed_lr", "zeroshot"
AQUAALERT_CLASSIFIER=auto
# Post-classification distress rules (promote clear first-person distress from offer_help/info_update to
# rescue_needed; see classify/rules.py): on | off
AQUAALERT_RULES=on
# Fine-tuned MuRIL directory (aquaalert.classify.train / scripts/fetch_model.py)
AQUAALERT_MODEL_DIR=models/muril
# Embedding + logistic-regression baseline (aquaalert.classify.embed_lr)
AQUAALERT_EMBED_DIR=models/embed_lr
# Base model for fine-tuning (fallback: xlm-roberta-base)
AQUAALERT_BASE_MODEL=google/muril-base-cased
# Geocoding (Nominatim requires a descriptive user agent)
AQUAALERT_GEOCODER_USER_AGENT=aquaalert-dev
AQUAALERT_GEOCODE_ONLINE=false
# Default dataset for the dashboard
AQUAALERT_DATASET=data/sample_posts.csv

# Hugging Face token (read access is enough) for scripts/fetch_model.py
HF_TOKEN=
# Optional full repo id; default is <your-hf-username>/aquaalert-muril
AQUAALERT_HF_REPO=

# --- Daily briefs (summarize/) ---
# Provider: "auto" tries gemini (GEMINI_API_KEY), then anthropic (ANTHROPIC_API_KEY), then openai (OPENAI_API_KEY),
# then the offline template. Or force "gemini", "anthropic", "openai", "template".
AQUAALERT_LLM_PROVIDER=auto
# Optional model override for the selected provider (defaults: gemini-3.5-flash-lite, claude-haiku-5-5, gpt-4o-mini).
# Leave blank when using auto, since a model name only fits one provider.
AQUAALERT_LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
